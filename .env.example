# Copy to `.env` (that file is not committed), then fill in the API key (both keys are the same key).
# Without .env, chat & embedding use local Ollama (qwen3.5:4b + bge-m3): 100% offline.

# Chat via Gemini (free tier). Delete these 4 lines to chat with qwen3.5:4b on Ollama.
CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_API_KEY=isi-api-key-gemini-di-sini
CHAT_MODEL=gemini-3.5-flash-lite
CHAT_REASONING_EFFORT=minimal

# Embedding via Gemini (recall@8 0.981 vs bge-m3 0.924). Delete these 3 lines to embed with bge-m3 on Ollama.
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBED_API_KEY=isi-api-key-gemini-di-sini
EMBED_MODEL=gemini-embedding-2
