# Salin jadi `.env` (file itu tidak di-commit), lalu isi API key (dua-duanya key yang sama).
# Tanpa .env, chat & embedding pakai Ollama lokal (qwen3.5:4b + bge-m3): 100% offline.

# Chat via Gemini (free tier). Hapus 4 baris ini untuk chat pakai qwen3.5:4b di Ollama.
CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_API_KEY=isi-api-key-gemini-di-sini
CHAT_MODEL=gemini-3.5-flash-lite
CHAT_REASONING_EFFORT=minimal

# Embedding via Gemini (recall@8 0.981 vs bge-m3 0.924). Hapus 3 baris ini untuk embedding pakai bge-m3 di Ollama.
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBED_API_KEY=isi-api-key-gemini-di-sini
EMBED_MODEL=gemini-embedding-2
