# Salin jadi `.env` (file itu tidak di-commit), lalu isi API key.
# Semua baris opsional: tanpa .env, chat & embedding pakai Ollama lokal.

# Chat via Gemini (free tier). Hapus 4 baris ini untuk kembali ke Ollama (qwen3.5:4b).
CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_API_KEY=isi-api-key-gemini-di-sini
CHAT_MODEL=gemini-3.5-flash-lite
CHAT_REASONING_EFFORT=minimal

# Embedding tetap bge-m3 di Ollama lokal (default). Contoh kalau mau pindah provider:
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=bge-m3
